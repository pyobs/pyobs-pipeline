# Copy to .env and fill in. docker-compose.yml passes these straight through to the
# web/worker/beat containers -- see pyobs_pipeline/settings.py for how they're read.

# Generate with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

DEBUG=false
ALLOWED_HOSTS=your-hostname-or-ip

# Generate with:
#   DJANGO_SETTINGS_MODULE=pyobs_pipeline.settings uv run python -c \
#     "from django.contrib.auth.hashers import make_password; print(make_password('yourpassword'))"
#
# IMPORTANT: docker compose interpolates .env values, so every literal "$" in the hash must be
# doubled to "$$" -- a bare "$" is read as a variable reference and silently blanked (with a
# real pbkdf2 hash that wipes out the salt and hash segments, and login fails with a 500).
# Compose unescapes "$$" back to a single "$" inside the container.
# e.g. pbkdf2_sha256$1500000$abc$def  ->  pbkdf2_sha256$$1500000$$abc$$def
#
# Only the legacy docker-compose v1 passes .env values through verbatim -- there, use the hash
# exactly as make_password() generated it, with no escaping. After deploying, verify the hash
# arrived intact (single "$" signs) before relying on login:
#   docker compose exec web printenv ADMIN_PASSWORD_HASH
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# "redis" is the Compose service name, not localhost -- containers reach each other by
# service name on the default Compose network.
CELERY_BROKER_URL=redis://redis:6379/0

MAX_BACKFILL_DAYS=7
