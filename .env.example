# Copy to .env and fill in. docker-compose.yml passes these straight through to the
# web/worker/beat containers -- see pyobs_pipeline/settings.py for how they're read.

# Generate with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

DEBUG=false
ALLOWED_HOSTS=your-hostname-or-ip

# Generate with:
#   DJANGO_SETTINGS_MODULE=pyobs_pipeline.settings uv run python -c \
#     "from django.contrib.auth.hashers import make_password; print(make_password('yourpassword'))"
#
# IMPORTANT: double every literal "$" in the hash to "$$" -- Compose interpolates .env
# values, so a bare "$" is misread as a variable reference and silently blanked out.
# e.g. pbkdf2_sha256$1500000$abc$def  ->  pbkdf2_sha256$$1500000$$abc$$def
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# "redis" is the Compose service name, not localhost -- containers reach each other by
# service name on the default Compose network.
CELERY_BROKER_URL=redis://redis:6379/0

MAX_BACKFILL_DAYS=7
