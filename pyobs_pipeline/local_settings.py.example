# Local overrides — copy this file to local_settings.py and fill in the values.
# local_settings.py is not committed to version control.

# Generate with:
#   DJANGO_SETTINGS_MODULE=pyobs_pipeline.settings uv run python -c \
#     "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY = ""

DEBUG = False
ALLOWED_HOSTS = ["your-hostname-or-ip"]

# Enable once HTTPS is in place
# SESSION_COOKIE_SECURE = True
# CSRF_COOKIE_SECURE = True

# Served behind a TLS-terminating proxy (nginx/caddy/tunnel)? Then the browser is on
# https while Django sees http, and the CSRF Origin check rejects every POST -- login
# included -- with "403 CSRF verification failed" unless the real origin is trusted:
# CSRF_TRUSTED_ORIGINS = ["https://pipeline.monet.uni-goettingen.de"]
# And if the proxy sets X-Forwarded-Proto, make Django see HTTPS too:
# SECURE_PROXY_SSL_HEADER = ("HTTP_X_FORWARDED_PROTO", "https")

# Generate the password hash with:
#   DJANGO_SETTINGS_MODULE=pyobs_pipeline.settings uv run python -c \
#     "from django.contrib.auth.hashers import make_password; print(make_password('yourpassword'))"
ADMIN_USERNAME = "admin"
ADMIN_PASSWORD_HASH = ""

# Celery broker — Redis, matching the current pipeline's setup
CELERY_BROKER_URL = "redis://localhost:6379/0"

# Backfill cap for missed Beat ticks (see reduction/scheduler.py)
MAX_BACKFILL_DAYS = 7
